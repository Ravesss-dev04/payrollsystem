generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                                 String                        @id @default(cuid())
  email                              String                        @unique @db.VarChar(320)
  name                               String                        @db.VarChar(160)
  passwordHash                       String?                       @db.VarChar(255)
  role                               UserRole
  status                             AccountStatus
  mfaSecretEncrypted                 String?                       @db.Text
  pendingMfaSecretEncrypted          String?                       @db.Text
  mfaEnabled                         Boolean                       @default(false)
  sessionVersion                     Int                           @default(0)
  lastLoginAt                        DateTime?
  isTestAccount                      Boolean                       @default(false)
  createdAt                          DateTime                      @default(now())
  updatedAt                          DateTime                      @updatedAt
  phoneNumber                        String?                       @db.VarChar(32)
  profileImageContentType            String?                       @db.VarChar(64)
  profileImageKey                    String?                       @db.VarChar(512)
  createdAttendancePolicies          AttendancePolicy[]            @relation("AttendancePolicyCreator")
  updatedAttendancePolicies          AttendancePolicy[]            @relation("AttendancePolicyUpdater")
  createdPolicyDepartmentAssignments AttendancePolicyDepartment[]  @relation("PolicyDepartmentAssignmentCreator")
  createdPolicyEmployeeAssignments   AttendancePolicyEmployee[]    @relation("PolicyEmployeeAssignmentCreator")
  domainAuditEvents                  DomainAuditEvent[]            @relation("DomainAuditActor")
  employeeRecord                     Employee?
  createdEmploymentPolicies          EmploymentStatusPolicy[]      @relation("EmploymentPolicyCreator")
  mfaChallenges                      MfaChallenge[]
  recoveryCodes                      MfaRecoveryCode[]
  passwordResetTokens                PasswordResetToken[]
  createdPayrollBatches              PayrollBatch[]                @relation("PayrollBatchCreator")
  timelineEvents                     PayrollBatchTimelineEvent[]   @relation("BatchTimelineActor")
  preparedPayrollVersions            PayrollBatchVersion[]         @relation("PayrollVersionPreparer")
  submittedPayrollVersions           PayrollBatchVersion[]         @relation("PayrollVersionSubmitter")
  approvedConfigVersions             PayrollConfigurationVersion[] @relation("ConfigVersionApprover")
  createdConfigVersions              PayrollConfigurationVersion[] @relation("ConfigVersionCreator")
  rejectedConfigVersions             PayrollConfigurationVersion[] @relation("ConfigVersionRejecter")
  submittedConfigVersions            PayrollConfigurationVersion[] @relation("ConfigVersionSubmitter")
  payrollDecisions                   PayrollDecision[]             @relation("PayrollDecisionActor")
  approvedDeductionCategorySets      PayrollDeductionCategorySet[] @relation("DeductionCategorySetApprover")
  createdDeductionCategorySets       PayrollDeductionCategorySet[] @relation("DeductionCategorySetCreator")
  disbursedPayrollRecords            PayrollDisbursementRecord[]   @relation("DisbursementActor")
  createdPayrollRuleSets             PayrollRuleSet[]              @relation("PayrollRuleSetCreator")
  createdRolePermissions             RolePermission[]              @relation("RolePermissionUpdater")
  targetedSecurityEvents             SecurityAuditEvent[]          @relation("SecurityEventTarget")
  securityEvents                     SecurityAuditEvent[]          @relation("SecurityEventActor")
  sessions                           Session[]
  activeInvitation                   UserInvitation?               @relation("ActiveInvitationUser")
  createdInvitations                 UserInvitation[]              @relation("InvitationCreator")
  invitations                        UserInvitation[]              @relation("InvitationTarget")
  createdPermissionDenials           UserPermissionDenial[]        @relation("UserPermissionDenialCreator")
  permissionDenials                  UserPermissionDenial[]        @relation("UserPermissionTarget")

  @@index([status, role])
}

model RolePermission {
  role            UserRole
  permission      String   @db.VarChar(80)
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  updatedBy       User?    @relation("RolePermissionUpdater", fields: [updatedByUserId], references: [id])

  @@id([role, permission])
  @@index([updatedByUserId])
}

model UserPermissionDenial {
  userId          String
  permission      String   @db.VarChar(80)
  createdByUserId String
  createdAt       DateTime @default(now())
  createdBy       User     @relation("UserPermissionDenialCreator", fields: [createdByUserId], references: [id])
  user            User     @relation("UserPermissionTarget", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@index([createdByUserId, createdAt])
}

model Session {
  id                String    @id @default(cuid())
  tokenHash         String    @unique @db.Char(64)
  csrfTokenHash     String    @db.Char(64)
  userId            String
  sessionVersion    Int
  createdAt         DateTime  @default(now())
  lastActivityAt    DateTime  @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model MfaChallenge {
  id         String              @id @default(cuid())
  tokenHash  String              @unique @db.Char(64)
  userId     String
  purpose    MfaChallengePurpose
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique @db.Char(64)
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @db.Char(64)
  userId     String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuthRateLimitBucket {
  id           String    @id @db.VarChar(160)
  count        Int       @default(0)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  blockedUntil DateTime?

  @@index([expiresAt])
}

model SecurityAuditEvent {
  id           String            @id @default(cuid())
  eventType    SecurityEventType
  userId       String?
  targetUserId String?
  resourceId   String?           @db.VarChar(160)
  sourceIp     String?           @db.VarChar(64)
  userAgent    String?           @db.VarChar(512)
  requestId    String?           @db.VarChar(128)
  succeeded    Boolean
  createdAt    DateTime          @default(now())
  targetUser   User?             @relation("SecurityEventTarget", fields: [targetUserId], references: [id])
  user         User?             @relation("SecurityEventActor", fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([eventType, createdAt])
}

model OrganizationSettings {
  id                 String                   @id @default("primary") @db.VarChar(32)
  name               String                   @db.VarChar(160)
  timeZone           String                   @db.VarChar(64)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  branches           Branch[]
  departments        Department[]
  employmentPolicies EmploymentStatusPolicy[]
}

model Branch {
  id             String               @id @default(cuid())
  organizationId String               @db.VarChar(32)
  name           String               @db.VarChar(120)
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   OrganizationSettings @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId, active, name])
}

model Department {
  id                          String                       @id @default(cuid())
  organizationId              String                       @db.VarChar(32)
  name                        String                       @db.VarChar(120)
  active                      Boolean                      @default(true)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  attendancePolicyAssignments AttendancePolicyDepartment[]
  organization                OrganizationSettings         @relation(fields: [organizationId], references: [id])
  employeeAssignments         EmployeeAssignment[]
  teams                       Team[]

  @@unique([organizationId, name])
  @@index([organizationId, active, name])
}

model Team {
  id           String     @id @default(cuid())
  departmentId String
  name         String     @db.VarChar(120)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([departmentId, name])
  @@index([departmentId, active, name])
}

model EmploymentStatusPolicy {
  id              String                       @id @default(cuid())
  organizationId  String                       @db.VarChar(32)
  version         Int
  effectiveFrom   DateTime                     @db.Date
  createdByUserId String
  createdAt       DateTime                     @default(now())
  definitions     EmploymentStatusDefinition[]
  createdBy       User                         @relation("EmploymentPolicyCreator", fields: [createdByUserId], references: [id])
  organization    OrganizationSettings         @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, version])
  @@unique([organizationId, effectiveFrom])
  @@index([organizationId, effectiveFrom, version])
  @@index([createdByUserId], map: "EmploymentStatusPolicy_createdByUserId_fkey")
}

model EmploymentStatusDefinition {
  id                  String                 @id @default(cuid())
  policyId            String
  code                String                 @db.VarChar(40)
  label               String                 @db.VarChar(100)
  active              Boolean                @default(true)
  headcountEligible   Boolean
  createdAt           DateTime               @default(now())
  employeeAssignments EmployeeAssignment[]
  policy              EmploymentStatusPolicy @relation(fields: [policyId], references: [id])

  @@unique([policyId, code])
  @@index([policyId, active, code])
  @@index([policyId, headcountEligible, active])
}

model Employee {
  id                          String                     @id @default(cuid())
  employeeNumber              String                     @unique @db.VarChar(64)
  firstName                   String                     @db.VarChar(80)
  lastName                    String                     @db.VarChar(80)
  workEmail                   String                     @unique @db.VarChar(320)
  userId                      String?                    @unique
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  attendancePolicyAssignments AttendancePolicyEmployee[]
  user                        User?                      @relation(fields: [userId], references: [id])
  assignments                 EmployeeAssignment[]
  payrollResults              PayrollEmployeeResult[]
  invitations                 UserInvitation[]

  @@index([lastName, firstName])
}

model EmployeeAssignment {
  id                 String                     @id @default(cuid())
  employeeId         String
  statusDefinitionId String
  departmentId       String
  effectiveFrom      DateTime                   @db.Date
  effectiveTo        DateTime?                  @db.Date
  createdAt          DateTime                   @default(now())
  department         Department                 @relation(fields: [departmentId], references: [id])
  employee           Employee                   @relation(fields: [employeeId], references: [id])
  statusDefinition   EmploymentStatusDefinition @relation(fields: [statusDefinitionId], references: [id])

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveTo, effectiveFrom])
  @@index([departmentId, effectiveFrom, effectiveTo])
  @@index([statusDefinitionId, effectiveFrom, effectiveTo])
}

model DomainAuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actorRole   UserRole
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(80)
  entityId    String
  summary     String   @db.VarChar(255)
  createdAt   DateTime @default(now())
  details     String?  @db.LongText
  actor       User?    @relation("DomainAuditActor", fields: [actorUserId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model PayrollRuleSet {
  id              String   @id @default(cuid())
  version         Int      @unique
  effectiveFrom   DateTime @db.Date
  configuration   String   @db.LongText
  createdByUserId String
  createdAt       DateTime @default(now())
  createdBy       User     @relation("PayrollRuleSetCreator", fields: [createdByUserId], references: [id])

  @@index([effectiveFrom, version])
  @@index([createdByUserId, createdAt])
}

model PayrollDeductionCategorySet {
  id               String                            @id @default(cuid())
  version          Int                               @unique
  status           PayrollDeductionCategorySetStatus @default(Draft)
  categories       String                            @db.LongText
  createdByUserId  String?
  approvedByUserId String?
  approvedAt       DateTime?
  createdAt        DateTime                          @default(now())
  payrollVersions  PayrollBatchVersion[]
  approvedBy       User?                             @relation("DeductionCategorySetApprover", fields: [approvedByUserId], references: [id])
  createdBy        User?                             @relation("DeductionCategorySetCreator", fields: [createdByUserId], references: [id])

  @@index([status, version])
  @@index([createdByUserId, createdAt])
  @@index([approvedByUserId], map: "PayrollDeductionCategorySet_approvedByUserId_fkey")
}

model PayrollBatch {
  id              String                @id @default(cuid())
  batchNumber     String                @unique @db.VarChar(64)
  createdByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  createdBy       User                  @relation("PayrollBatchCreator", fields: [createdByUserId], references: [id])
  versions        PayrollBatchVersion[]

  @@index([createdByUserId, createdAt])
}

model PayrollBatchVersion {
  id                          String                       @id @default(cuid())
  batchId                     String
  version                     Int
  status                      PayrollBatchVersionStatus    @default(Draft)
  periodStart                 DateTime                     @db.Date
  periodEnd                   DateTime                     @db.Date
  cutoffReference             String                       @db.VarChar(160)
  currencyCode                String                       @db.Char(3)
  sourceReference             String                       @db.VarChar(512)
  sourceCalculatedAt          DateTime?
  preparedByUserId            String
  preparedByNameSnapshot      String?
  submittedByUserId           String?
  submittedByNameSnapshot     String?
  submittedAt                 DateTime?
  organizationNameSnapshot    String?                      @db.VarChar(160)
  timeZoneSnapshot            String?                      @db.VarChar(64)
  deductionCategorySetVersion Int?
  employeeCount               Int
  grossPayable                Decimal                      @db.Decimal(19, 4)
  totalDeductions             Decimal                      @db.Decimal(19, 4)
  netPayable                  Decimal                      @db.Decimal(19, 4)
  employerContributions       Decimal?                     @db.Decimal(19, 4)
  laborCost                   Decimal?                     @db.Decimal(19, 4)
  overtimeCost                Decimal?                     @db.Decimal(19, 4)
  createdAt                   DateTime                     @default(now())
  benefitsConfigVersion       Int?
  calculationEngineVersion    String?                      @db.VarChar(32)
  deductionConfigVersion      Int?
  earningsConfigVersion       Int?
  statutoryRuleVersion        Int?
  batch                       PayrollBatch                 @relation(fields: [batchId], references: [id])
  deductionCategorySet        PayrollDeductionCategorySet? @relation(fields: [deductionCategorySetVersion], references: [version], onDelete: Restrict)
  preparedBy                  User                         @relation("PayrollVersionPreparer", fields: [preparedByUserId], references: [id])
  submittedBy                 User?                        @relation("PayrollVersionSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  decisions                   PayrollDecision?
  disbursementRecord          PayrollDisbursementRecord?
  employees                   PayrollEmployeeResult[]
  exceptions                  PayrollValidationException[]

  @@unique([batchId, version])
  @@index([status, submittedAt])
  @@index([periodStart, periodEnd])
  @@index([preparedByUserId, createdAt])
  @@index([deductionCategorySetVersion], map: "PayrollBatchVersion_deductionCategorySetVersion_fkey")
  @@index([submittedByUserId], map: "PayrollBatchVersion_submittedByUserId_fkey")
}

model PayrollEmployeeResult {
  id                String                       @id @default(cuid())
  payrollVersionId  String
  employeeId        String?
  employeeReference String
  employeeNumber    String                       @db.VarChar(64)
  employeeName      String                       @db.VarChar(160)
  department        String                       @db.VarChar(120)
  position          String?                      @db.VarChar(120)
  compensationBasis String                       @db.VarChar(32)
  applicableRate    Decimal                      @db.Decimal(19, 4)
  daysWorked        Decimal?                     @db.Decimal(9, 4)
  regularHours      Decimal?                     @db.Decimal(9, 4)
  overtimeHours     Decimal?                     @db.Decimal(9, 4)
  grossPay          Decimal                      @db.Decimal(19, 4)
  totalDeductions   Decimal                      @db.Decimal(19, 4)
  netPay            Decimal                      @db.Decimal(19, 4)
  sourceReference   String                       @db.VarChar(512)
  adjustments       PayrollAdjustmentEvidence[]
  attendance        PayrollAttendanceRecord[]
  deductions        PayrollDeductionLine[]
  earnings          PayrollEarningLine[]
  employee          Employee?                    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payrollVersion    PayrollBatchVersion          @relation(fields: [payrollVersionId], references: [id])
  exceptions        PayrollValidationException[]

  @@unique([payrollVersionId, employeeId])
  @@unique([payrollVersionId, employeeReference])
  @@unique([payrollVersionId, employeeNumber])
  @@index([employeeId, payrollVersionId])
}

model PayrollEarningLine {
  id               String                @id @default(cuid())
  employeeResultId String
  category         String                @db.VarChar(40)
  label            String                @db.VarChar(120)
  amount           Decimal               @db.Decimal(19, 4)
  sourceReference  String                @db.VarChar(512)
  employeeResult   PayrollEmployeeResult @relation(fields: [employeeResultId], references: [id])

  @@index([employeeResultId, category])
}

model PayrollDeductionLine {
  id               String                @id @default(cuid())
  employeeResultId String
  category         String                @db.VarChar(40)
  label            String                @db.VarChar(120)
  amount           Decimal               @db.Decimal(19, 4)
  sourceReference  String                @db.VarChar(512)
  employeeResult   PayrollEmployeeResult @relation(fields: [employeeResultId], references: [id])

  @@index([employeeResultId, category])
}

model PayrollAttendanceRecord {
  id                     String                @id @default(cuid())
  employeeResultId       String
  sourceReference        String                @db.VarChar(512)
  workDate               DateTime              @db.Date
  timeIn                 DateTime?
  timeOut                DateTime?
  totalHours             Decimal?              @db.Decimal(9, 4)
  regularHours           Decimal?              @db.Decimal(9, 4)
  overtimeHours          Decimal?              @db.Decimal(9, 4)
  nightDifferentialHours Decimal?              @db.Decimal(9, 4)
  classification         String?               @db.VarChar(80)
  approvalStatus         String?               @db.VarChar(40)
  exceptionDetails       String?               @db.VarChar(1000)
  employeeResult         PayrollEmployeeResult @relation(fields: [employeeResultId], references: [id])

  @@unique([employeeResultId, sourceReference], map: "PayrollAttendance_result_source_key")
  @@index([employeeResultId, workDate])
}

model PayrollAdjustmentEvidence {
  id                  String                @id @default(cuid())
  employeeResultId    String
  adjustmentReference String
  sourceReference     String                @db.VarChar(512)
  adjustmentType      String                @db.VarChar(80)
  amount              Decimal               @db.Decimal(19, 4)
  reason              String                @db.VarChar(1000)
  requestedBy         String                @db.VarChar(160)
  approvedBy          String?               @db.VarChar(160)
  approvedAt          DateTime?
  status              String                @db.VarChar(40)
  employeeResult      PayrollEmployeeResult @relation(fields: [employeeResultId], references: [id])

  @@unique([employeeResultId, adjustmentReference], map: "PayrollAdjustment_result_ref_key")
  @@index([employeeResultId, status])
}

model PayrollValidationException {
  id                String                   @id @default(cuid())
  payrollVersionId  String
  employeeResultId  String?
  fingerprint       String                   @db.Char(64)
  category          String                   @db.VarChar(80)
  severity          PayrollExceptionSeverity
  title             String                   @db.VarChar(160)
  description       String                   @db.VarChar(2000)
  field             String?                  @db.VarChar(120)
  actualValue       String?                  @db.VarChar(1000)
  expectedValue     String?                  @db.VarChar(1000)
  sourceReference   String?                  @db.VarChar(512)
  detectedAt        DateTime                 @default(now())
  resolvedAt        DateTime?
  resolutionDetails String?                  @db.VarChar(1000)
  employeeResult    PayrollEmployeeResult?   @relation(fields: [employeeResultId], references: [id], onDelete: Restrict)
  payrollVersion    PayrollBatchVersion      @relation(fields: [payrollVersionId], references: [id])

  @@unique([payrollVersionId, fingerprint])
  @@index([payrollVersionId, resolvedAt, severity, detectedAt], map: "PayrollException_version_state_idx")
  @@index([employeeResultId, detectedAt])
}

model PayrollDecision {
  id               String              @id @default(cuid())
  payrollVersionId String              @unique
  actorUserId      String
  decision         PayrollDecisionType
  reason           String?             @db.VarChar(1000)
  createdAt        DateTime            @default(now())
  actor            User                @relation("PayrollDecisionActor", fields: [actorUserId], references: [id])
  payrollVersion   PayrollBatchVersion @relation(fields: [payrollVersionId], references: [id])

  @@index([actorUserId, createdAt])
}

model PayrollConfigurationVersion {
  id                  String                     @id @default(cuid())
  version             Int                        @unique
  category            String                     @db.VarChar(64)
  status              PayrollConfigurationStatus @default(Draft)
  configuration       String                     @db.LongText
  applicability       String                     @db.LongText
  effectiveFrom       DateTime                   @db.Date
  effectiveTo         DateTime?                  @db.Date
  changeReason        String                     @db.VarChar(1000)
  supportingReference String?                    @db.VarChar(512)
  simulationImpact    String?                    @db.LongText
  createdByUserId     String
  submittedByUserId   String?
  submittedAt         DateTime?
  approvedByUserId    String?
  approvedAt          DateTime?
  rejectedByUserId    String?
  rejectedAt          DateTime?
  rejectionReason     String?                    @db.VarChar(1000)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  approvedBy          User?                      @relation("ConfigVersionApprover", fields: [approvedByUserId], references: [id])
  createdBy           User                       @relation("ConfigVersionCreator", fields: [createdByUserId], references: [id])
  rejectedBy          User?                      @relation("ConfigVersionRejecter", fields: [rejectedByUserId], references: [id])
  submittedBy         User?                      @relation("ConfigVersionSubmitter", fields: [submittedByUserId], references: [id])

  @@index([status, category, version])
  @@index([effectiveFrom, effectiveTo])
  @@index([createdByUserId, createdAt])
  @@index([approvedByUserId], map: "PayrollConfigurationVersion_approvedByUserId_fkey")
  @@index([rejectedByUserId], map: "PayrollConfigurationVersion_rejectedByUserId_fkey")
  @@index([submittedByUserId], map: "PayrollConfigurationVersion_submittedByUserId_fkey")
}

model PayrollBatchTimelineEvent {
  id                     String   @id @default(cuid())
  batchId                String
  version                Int
  eventType              String   @db.VarChar(80)
  description            String   @db.VarChar(1000)
  actorUserId            String?
  actorRole              String?  @db.VarChar(40)
  actorName              String?  @db.VarChar(160)
  relatedRecordReference String?
  metadata               String?  @db.LongText
  createdAt              DateTime @default(now())
  actor                  User?    @relation("BatchTimelineActor", fields: [actorUserId], references: [id])

  @@index([batchId, version, createdAt])
  @@index([eventType, createdAt])
  @@index([actorUserId], map: "PayrollBatchTimelineEvent_actorUserId_fkey")
}

model PayrollDisbursementRecord {
  id                    String                    @id @default(cuid())
  payrollVersionId      String                    @unique
  disbursementReference String                    @unique
  status                PayrollDisbursementStatus @default(PendingDisbursement)
  disbursedByUserId     String?
  disbursedAt           DateTime?
  paymentMethod         String?                   @db.VarChar(64)
  notes                 String?                   @db.VarChar(1000)
  failureReason         String?                   @db.VarChar(1000)
  metadata              String?                   @db.LongText
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  disbursedBy           User?                     @relation("DisbursementActor", fields: [disbursedByUserId], references: [id])
  payrollVersion        PayrollBatchVersion       @relation(fields: [payrollVersionId], references: [id])

  @@index([status, createdAt])
  @@index([disbursedByUserId], map: "PayrollDisbursementRecord_disbursedByUserId_fkey")
}

model UserInvitation {
  id              String           @id @default(cuid())
  userId          String
  employeeId      String
  role            UserRole
  tokenHash       String           @unique @db.Char(64)
  activeUserId    String?          @unique
  status          InvitationStatus @default(Pending)
  message         String?          @db.VarChar(1000)
  expiresAt       DateTime
  sentAt          DateTime?
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  activeUser      User?            @relation("ActiveInvitationUser", fields: [activeUserId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("InvitationCreator", fields: [createdByUserId], references: [id])
  employee        Employee         @relation(fields: [employeeId], references: [id])
  user            User             @relation("InvitationTarget", fields: [userId], references: [id])

  @@index([employeeId, status, expiresAt])
  @@index([createdByUserId, createdAt])
  @@index([userId], map: "UserInvitation_userId_fkey")
}

model AttendancePolicy {
  id                         String                       @id @default(cuid())
  code                       String                       @unique @db.VarChar(40)
  name                       String                       @unique @db.VarChar(160)
  description                String?                      @db.VarChar(1000)
  status                     AttendancePolicyStatus       @default(Active)
  scope                      AttendancePolicyScope
  precedence                 Int                          @default(100)
  effectiveFrom              DateTime                     @db.Date
  effectiveTo                DateTime?                    @db.Date
  scheduleType               AttendanceScheduleType
  timeZone                   String                       @db.VarChar(64)
  workDays                   String                       @db.LongText
  shiftStart                 String?                      @db.VarChar(5)
  shiftEnd                   String?                      @db.VarChar(5)
  breakStart                 String?                      @db.VarChar(5)
  breakEnd                   String?                      @db.VarChar(5)
  breakPaid                  Boolean                      @default(false)
  gracePeriodMinutes         Int                          @default(0)
  missingTimeInRule          String                       @db.VarChar(120)
  missingTimeOutRule         String                       @db.VarChar(120)
  earlyOutRule               String                       @db.VarChar(120)
  undertimeRule              String                       @db.VarChar(120)
  absenceRule                String                       @db.VarChar(120)
  correctionsRequireApproval Boolean                      @default(true)
  overtimeEnabled            Boolean                      @default(false)
  overtimePriorApproval      Boolean                      @default(true)
  overtimeMinimumMinutes     Int?
  overtimeRoundingMinutes    Int?
  overtimeMaximumMinutes     Int?
  createdByUserId            String
  updatedByUserId            String?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  createdBy                  User                         @relation("AttendancePolicyCreator", fields: [createdByUserId], references: [id])
  updatedBy                  User?                        @relation("AttendancePolicyUpdater", fields: [updatedByUserId], references: [id])
  departmentAssignments      AttendancePolicyDepartment[]
  employeeAssignments        AttendancePolicyEmployee[]

  @@index([status, effectiveFrom, effectiveTo])
  @@index([scope, precedence, status])
  @@index([createdByUserId, createdAt])
  @@index([updatedByUserId], map: "AttendancePolicy_updatedByUserId_fkey")
}

model AttendancePolicyDepartment {
  policyId         String
  departmentId     String
  assignedByUserId String
  createdAt        DateTime         @default(now())
  assignedBy       User             @relation("PolicyDepartmentAssignmentCreator", fields: [assignedByUserId], references: [id])
  department       Department       @relation(fields: [departmentId], references: [id])
  policy           AttendancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@id([policyId, departmentId])
  @@index([departmentId, policyId])
  @@index([assignedByUserId, createdAt])
}

model AttendancePolicyEmployee {
  policyId         String
  employeeId       String
  assignedByUserId String
  createdAt        DateTime         @default(now())
  assignedBy       User             @relation("PolicyEmployeeAssignmentCreator", fields: [assignedByUserId], references: [id])
  employee         Employee         @relation(fields: [employeeId], references: [id])
  policy           AttendancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@id([policyId, employeeId])
  @@index([employeeId, policyId])
  @@index([assignedByUserId, createdAt])
}

