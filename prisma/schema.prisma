  versions        PayrollBatchVersion[]

  @@index([createdByUserId, createdAt])
}

model PayrollBatchVersion {
  id                          String                       @id @default(cuid())
  batchId                     String                       @db.VarChar(191)
  version                     Int
  status                      PayrollBatchVersionStatus    @default(Draft)
  periodStart                 DateTime                     @db.Date
  periodEnd                   DateTime                     @db.Date
  cutoffReference             String                       @db.VarChar(160)
  currencyCode                String                       @db.Char(3)
  sourceReference             String                       @db.VarChar(512)
  sourceCalculatedAt          DateTime?                    @db.DateTime(3)
  preparedByUserId            String                       @db.VarChar(191)
  preparedByNameSnapshot      String?                      @db.VarChar(191)
  submittedByUserId           String?                      @db.VarChar(191)
  submittedByNameSnapshot     String?                      @db.VarChar(191)
  submittedAt                 DateTime?                    @db.DateTime(3)
  organizationNameSnapshot    String?                      @db.VarChar(160)
  timeZoneSnapshot            String?                      @db.VarChar(64)
  deductionCategorySetVersion Int?
  calculationEngineVersion    String?                      @db.VarChar(32)
  earningsConfigVersion       Int?
  deductionConfigVersion      Int?
  benefitsConfigVersion       Int?
  statutoryRuleVersion        Int?
  employeeCount               Int
  grossPayable                Decimal                      @db.Decimal(19, 4)
  totalDeductions             Decimal                      @db.Decimal(19, 4)
  netPayable                  Decimal                      @db.Decimal(19, 4)
  employerContributions       Decimal?                     @db.Decimal(19, 4)
  laborCost                   Decimal?                     @db.Decimal(19, 4)
  overtimeCost                Decimal?                     @db.Decimal(19, 4)
  createdAt                   DateTime                     @default(now()) @db.DateTime(3)
  batch                       PayrollBatch                 @relation(fields: [batchId], references: [id], onDelete: Restrict)
  preparedBy                  User                         @relation("PayrollVersionPreparer", fields: [preparedByUserId], references: [id], onDelete: Restrict)
  submittedBy                 User?                        @relation("PayrollVersionSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  employees                   PayrollEmployeeResult[]
  exceptions                  PayrollValidationException[]
  decisions                   PayrollDecision[]
  deductionCategorySet        PayrollDeductionCategorySet? @relation(fields: [deductionCategorySetVersion], references: [version], onDelete: Restrict)
  disbursementRecord          PayrollDisbursementRecord?

  @@unique([batchId, version])
  @@index([status, submittedAt])
  @@index([periodStart, periodEnd])
  @@index([preparedByUserId, createdAt])
}

model PayrollEmployeeResult {
  id                String                       @id @default(cuid())
  payrollVersionId  String                       @db.VarChar(191)
  employeeId        String?                      @db.VarChar(191)
  employeeReference String                       @db.VarChar(191)
  employeeNumber    String                       @db.VarChar(64)
  employeeName      String                       @db.VarChar(160)
  department        String                       @db.VarChar(120)
  position          String?                      @db.VarChar(120)
  compensationBasis String                       @db.VarChar(32)
  applicableRate    Decimal                      @db.Decimal(19, 4)
  daysWorked        Decimal?                     @db.Decimal(9, 4)
  regularHours      Decimal?                     @db.Decimal(9, 4)
  overtimeHours     Decimal?                     @db.Decimal(9, 4)
  grossPay          Decimal                      @db.Decimal(19, 4)
  totalDeductions   Decimal                      @db.Decimal(19, 4)
  netPay            Decimal                      @db.Decimal(19, 4)
  sourceReference   String                       @db.VarChar(512)
  payrollVersion    PayrollBatchVersion          @relation(fields: [payrollVersionId], references: [id], onDelete: Restrict)
  employee          Employee?                    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  earnings          PayrollEarningLine[]
  deductions        PayrollDeductionLine[]
  attendance        PayrollAttendanceRecord[]
  adjustments       PayrollAdjustmentEvidence[]
  exceptions        PayrollValidationException[]

  @@unique([payrollVersionId, employeeId])
  @@unique([payrollVersionId, employeeReference])
  @@unique([payrollVersionId, employeeNumber])
  @@index([employeeId, payrollVersionId])
}

