  updatedPayGrades                   PayGrade[]                    @relation("PayGradeUpdater")
  createdAllowancePolicies           AllowancePolicy[]             @relation("AllowanceCreator")
  updatedAllowancePolicies           AllowancePolicy[]             @relation("AllowanceUpdater")
